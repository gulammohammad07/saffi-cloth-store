# Neon Postgres Database URL (Required)
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth Secret for session encryption (Required in production: `openssl rand -base64 32`)
AUTH_SECRET=

# Public site origin (e.g. http://localhost:3000 or https://yourdomain.com)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth 2.0 Credentials (from Google Cloud Console)
# Authorized redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=

# Razorpay (server-only; never prefix the secret with NEXT_PUBLIC_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Existing Cloudinary configuration required for product media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP mail server used for order notifications (server-only).
# New orders are emailed to the store's support email (Admin → Settings),
# so no extra recipient variable is needed.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
